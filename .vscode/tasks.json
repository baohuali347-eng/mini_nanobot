{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mini_nanobot: 完整前后端",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "mini_nanobot",
        "web"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "mini_nanobot: 初始化配置",
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "mini_nanobot: 前端开发",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "mini_nanobot",
        "web",
        "--dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "mini_nanobot: 初始化配置",
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "mini_nanobot: 初始化配置",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "mini_nanobot",
        "init",
        "--if-missing"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "mini_nanobot: 运行",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "mini_nanobot",
        "code",
        "-w",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "mini_nanobot: 初始化配置",
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "mini_nanobot: 测试",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "pytest",
        "tests",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
